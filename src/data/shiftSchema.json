                "type": "select",
                "required": true,
                "colSpan": "12 md:col-span-6",
                "options": [
                    {
                        "label": "Fixed - Same timing every day",
                        "value": "fixed"
                    },
                    {
                        "label": "Rotational",
                        "value": "rotational"
                    }
                ]
            },
            {
                "name": "colorCode",
                "label": "Color Code",
                "type": "text",
                "colSpan": "12 md:col-span-6",
                "placeholder": "#000000",
                "tooltip": "For calendar display"
            },
            {
                "name": "isActive",
                "label": "Active",
                "type": "switch",
                "colSpan": "12"
